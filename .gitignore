# Your saved work. This is your data, not the application - it stays on your
# machine and must never be committed to a public repository.
data/

# Per-machine setting written by the launcher (which shared data folder this
# PC uses). The path is personal to each user's OneDrive, so it never belongs
# in the repository.
config.json

# The previous version, kept by the launcher when it installs an update.
backup/

# Generated by build/Make-Portable.ps1 on demand; 1.6 MB of duplicated code
# that would bloat every clone and every diff.
DPM-FTE-Calculator-portable.html

# OS and editor noise
Thumbs.db
desktop.ini
.DS_Store
*.swp
.vscode/
.idea/
